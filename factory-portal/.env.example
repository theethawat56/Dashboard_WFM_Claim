TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_token_here

# Public address of this portal. Used inside notification emails.
# Local preview: http://localhost:3001
# Production on pungo-server: https://claims.pungo.cc
FACTORY_PORTAL_PUBLIC_URL=http://localhost:3001

# Internal notification inbox.
FACTORY_PORTAL_NOTIFY_EMAIL=theethawat56@gmail.com
RESEND_API_KEY=
FACTORY_PORTAL_FROM=Factory Claims <onboarding@resend.dev>

# Long random string. Opens /staff/<token> so the team can copy factory links.
FACTORY_PORTAL_STAFF_TOKEN=

# Same value as the dashboard cron secret, if you set one on Vercel.
CRON_SECRET=
