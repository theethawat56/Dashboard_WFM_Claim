TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_token_here
NEXT_PUBLIC_APP_TITLE=Repair & Claim Dashboard

# Vercel Cron — secures the /api/cron/sync endpoint (set in Vercel dashboard)
# Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# Factory portal base URL, used to build the links shown on the factory tab.
# Local preview: http://localhost:3001
# Production on pungo-server: https://claims.pungo.cc
FACTORY_PORTAL_PUBLIC_URL=http://localhost:3001

# Zortout Purchase Orders (never commit real keys)
ZORT_STORENAME=your-zort-store-email
ZORT_API_KEY=your-zort-api-key
ZORT_API_SECRET=your-zort-api-secret
